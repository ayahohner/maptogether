    "werift": "0.24.4",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [],
  "name": "maptogether",
  "packageManager": "yarn@4.18.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "serve": "vite preview",
    "test": "vitest",
    "relay:dev": "wrangler dev -c relay/wrangler.jsonc --var 'ALLOWED_ORIGINS:http://localhost:*'",
    "dev:local": "yarn relay:dev --port 8790 & VITE_SYNC_RELAY_URL=http://localhost:8790 vite",
    "relay:deploy": "wrangler deploy -c relay/wrangler.jsonc",
    "quality": "node scripts/quality-gate.mjs",
    "version:check": "node scripts/version-check.mjs",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test:live": "LIVE_RELAY=${LIVE_RELAY:-https://maptogether-relay.innerlattice.workers.dev} vitest run src/sync/relay.live.test.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "version": "5.2.0",
  "type": "module",
  "lint-staged": {
    "*.{js,mjs,ts,tsx,css,json,jsonc}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
