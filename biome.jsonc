{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // index.html is mostly crawlable copy laid out by hand; public/ and docs/
    // hold generated or third-party files. The parse tree types are generated.
    "includes": [
      "**",
      "!.yarn",
      "!dist",
      "!public",
      "!docs",
      "!index.html",
      "!**/*.woff2",
      "!src/parser/*Cst.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // DOM lookups of elements that index.html always contains.
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.*"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ],
  // Import order matters here: Editor and State import each other.
  "assist": { "enabled": false }
}
